# Postgres connection string.
# On Vercel: add the "Postgres" Storage integration from your project's
# Storage tab — Vercel injects POSTGRES_URL (and related vars) automatically,
# no manual copy-paste needed.
# For local development: point this at any Postgres instance.
POSTGRES_URL=postgres://user:password@localhost:5432/africakani

# Admin back-office (/admin) — pick your own values.
# ADMIN_PASSWORD: the password used to log into /admin/login.
# ADMIN_SESSION_SECRET: any long random string, used to sign admin session
# cookies. Generate one with: openssl rand -base64 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too

# Resend — used to email a notification when someone submits the "product
# not found" request form. Get a key at https://resend.com/api-keys after
# creating a free account (no domain verification needed to get started —
# see the setup steps you were given).
RESEND_API_KEY=re_your_api_key

# Optional: sender address. Defaults to Resend's shared "onboarding@resend.dev"
# address, which works immediately with no setup. Once africakani.com is
# verified in Resend (Domains tab), set this to a branded address, e.g.
# RESEND_FROM=AfricAkani <no-reply@africakani.com>
RESEND_FROM=AfricAkani <onboarding@resend.dev>

# Who receives admin notifications: new orders and new "product not found"
# requests. Defaults to contact@africakani.com. (NOTIFY_EMAIL is still read
# as a fallback for older deployments, but ADMIN_NOTIFY_EMAIL is preferred.)
ADMIN_NOTIFY_EMAIL=contact@africakani.com

# The site's public URL — used to build canonical/Open Graph tags, the
# sitemap, robots.txt, and links inside transactional e-mails.
NEXT_PUBLIC_SITE_URL=https://www.africakani.com

# How many hours an order can stay unpaid before it's shown on the site and
# in the confirmation e-mail, and before the cron job (see below)
# auto-cancels it. Defaults to 72.
NEXT_PUBLIC_ORDER_PAYMENT_TIMEOUT_HOURS=72

# Secret shared with Vercel Cron to authorize calls to
# /api/cron/order-reminders (sends the 24h/48h payment reminders and
# auto-cancels orders past NEXT_PUBLIC_ORDER_PAYMENT_TIMEOUT_HOURS).
# Vercel automatically sends this as "Authorization: Bearer <value>" when
# invoking a cron defined in vercel.json — generate one with:
# openssl rand -base64 32
CRON_SECRET=change-me-too

# Maintenance mode — set to "true" to show every visitor a branded "coming
# soon" page (HTTP 503) instead of the storefront. /admin and /api/cron
# always keep working. Set back to "false" (or remove the variable) to
# reopen the site.
MAINTENANCE_MODE=false

# Secret used to preview the real site while MAINTENANCE_MODE=true — visit
# https://www.africakani.com/?preview=<this value> once to get a bypass
# cookie (valid 30 days). Generate one with: openssl rand -base64 32
MAINTENANCE_BYPASS_KEY=change-me-too

# Vercel Blob storage — used for product image uploads in the admin
# (/admin/produits). Enable it once from the Vercel dashboard: your
# project → Storage tab → Create Database → Blob. Vercel then injects
# this variable automatically for every environment, the same way
# POSTGRES_URL is injected once Postgres is added — nothing to paste here
# by hand in production.
BLOB_READ_WRITE_TOKEN=

# Stripe — card payments for the CA Canada and US États-Unis zones only
# ("Payer par carte" at checkout, alongside WhatsApp). Bénin (FCFA) keeps
# Mobile Money + WhatsApp and does not use Stripe.
# Get these from the Stripe Dashboard (https://dashboard.stripe.com/apikeys)
# — use the *test* keys while developing, switch to live keys in production.
# STRIPE_SECRET_KEY: the checkout page only offers "Payer par carte" when
# this is set — leave it unset to keep Stripe disabled.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Required to receive payment confirmations: create a webhook endpoint in
# the Stripe Dashboard (Developers → Webhooks) pointing to
# https://www.africakani.com/api/webhooks/stripe, subscribed to the
# "checkout.session.completed" event, then paste its signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
